# ==========================================================================
# HR Pro v6.0 — Environment Variables Template
# ==========================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored — never commit real secrets.
# ==========================================================================

# ------------- Supabase -------------
# Project URL and anon (publishable) key from Supabase dashboard.
# The anon key is safe to expose in client code IF RLS is enabled properly.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# ------------- Feature flags -------------
# NEXT_PUBLIC_FEATURE_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_FEATURE_ENABLE_BETA=false

# ==========================================================================
# For Flutter builds, pass the same values via --dart-define:
#
#   flutter build apk --release \
#     --dart-define=SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
# ==========================================================================
