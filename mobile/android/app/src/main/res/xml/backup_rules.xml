<?xml version="1.0" encoding="utf-8"?>
<!--
     قواعد النسخ الاحتياطي (Android 6-11)
     نمنع نسخ:
       - shared_preferences (تحوي تاريخ نشاط الجلسة)
       - flutter_secure_storage (رموز المصادقة)
       - قواعد بيانات محلية للتطبيق (إن وُجدت)
     نتيجة: بيانات المصادقة لا تتسرّب عبر Google Drive Backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="root" path="secure_storage/"/>
    <exclude domain="file" path="."/>
</full-backup-content>
